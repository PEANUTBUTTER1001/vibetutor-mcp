{#- 표준 교재 템플릿 (DESIGN.md 양식 준수).
    토큰/컴포넌트 CSS 는 inline include 하여 WeasyPrint 가 외부 CSS 경로 해석 없이
    단일 HTML 만으로 렌더링하도록 한다. @font-face 의 한글 폰트는 익스포터가 전달하는
    base_url(templates/fonts) 로 해석된다. 모든 사용자 입력은 autoescape 로 안전화된다. -#}
<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>{{ topic }}</title>
    <style>
      {% include "styles/tokens.css" %}
      {% include "styles/components.css" %}
    </style>
  </head>
  <body>
    <header class="cover">
      <h1 class="cover-title">{{ topic }}</h1>
      <div class="meta">
        <div><span class="label">생성 도구</span>VibeTutor MCP</div>
        {% if generated_at %}
        <div><span class="label">작성일자</span>{{ generated_at }}</div>
        {% endif %}
        <div><span class="label">구성</span>{{ sections | length }}개 섹션</div>
        {% if content_hash %}
        <div><span class="label">콘텐츠 해시</span>{{ content_hash[:16] }}</div>
        {% endif %}
      </div>
      <div class="callout warn">
        <div class="title">AI 생성 초안 — 검증 필요</div>
        이 교재는 자동 생성된 초안입니다. 코드 예제와 설명의 정확성을 반드시 검토한 뒤 학습에 활용하세요.
      </div>
    </header>

    {% for section in sections %}
    <section class="section">
      <h2><span class="num">{{ "%02d" | format(loop.index) }}</span>{{ section.heading }}</h2>
      <div class="concept">{{ section.concept_explanation }}</div>

      {% if section.code_example %}
      <h3>코드 예제</h3>
      <pre><code>{{ section.code_example }}</code></pre>
      {% if section.code_source %}
      <p class="code-source">출처: {{ section.code_source }}</p>
      {% endif %}
      {% endif %}

      {% if section.exercises %}
      <h3>연습 문제</h3>
      <div class="concept">{{ section.exercises }}</div>
      {% endif %}
    </section>
    {% endfor %}
  </body>
</html>
